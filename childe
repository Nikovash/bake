#!/usr/bin/env bash
set -euo pipefail

# --- sudo error ---#
if [[ "$EUID" -eq 0 ]]; then
  echo "[Julia Childe] Do not run this tool with sudo."
  exit 1
fi

# --- Paths --- #
RUN_DIR="$(pwd -P)"
RECIPE_BOOK="${RUN_DIR}/recipe_book.conf"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ASSET_PULL="${SCRIPT_DIR}/assets/asset_pull.sh"
OPT_KITCHEN_LIB="/opt/bake/kitchen.lib"

declare -A SELECTED

die() {
  echo "[ERROR] $*" >&2
  exit 1
}

require_whiptail() {
  command -v whiptail >/dev/null 2>&1 || die "whiptail is not installed. Install it with: sudo apt-get install whiptail"
}

require_kitchen() {
  [[ -f "$ASSET_PULL" ]] || die "Missing ${ASSET_PULL}"

  # shellcheck disable=SC1090
  source "$ASSET_PULL"
  ensure_kitchen_lib

  [[ -f "$OPT_KITCHEN_LIB" ]] || die "Missing ${OPT_KITCHEN_LIB} after asset pull."

  # shellcheck disable=SC1090
  source "$OPT_KITCHEN_LIB"
}

load_existing_selection() {
  local default_target
  default_target="$(detect_default_friendly_target)"

  for target in "${ALL_RECIPE_TARGETS[@]}"; do
    if [[ "$target" == "$default_target" ]]; then
      SELECTED["$target"]="y"
    else
      SELECTED["$target"]="n"
    fi
  done

  [[ -f "$RECIPE_BOOK" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    [[ "$line" =~ ^[[:space:]]*# ]] && continue

    local target enabled
    IFS=',' read -r target enabled <<< "$line" || continue

    [[ "$enabled" == "y" || "$enabled" == "n" ]] || continue
    is_known_recipe_target "$target" || continue

    SELECTED["$target"]="$enabled"
  done < "$RECIPE_BOOK"
}

status_of_target() {
  local target="$1"
  [[ "${SELECTED[$target]:-n}" == "y" ]] && echo ON || echo OFF
}

show_checklist() {
  whiptail \
    --title "Bake Toolchain - {Julia} Childe" \
    --checklist "Select build targets\n\nArrow keys = move\nSpace = toggle\nTab = buttons\nEnter = submit\n\nAt least one target must be selected." \
    22 78 12 \
    "Linux 64-bit"      "x86_64-pc-linux-gnu"         "$(status_of_target "Linux 64-bit")" \
    "Linux 32-bit"      "i686-pc-linux-gnu"           "$(status_of_target "Linux 32-bit")" \
    "Linux ARM 32-bit"  "arm-linux-gnueabihf"         "$(status_of_target "Linux ARM 32-bit")" \
    "Linux ARM 64-bit"  "aarch64-linux-gnu"           "$(status_of_target "Linux ARM 64-bit")" \
    "Raspberry Pi 4+"   "aarch64-linux-gnu (Pi)"      "$(status_of_target "Raspberry Pi 4+")" \
    "Oracle Ampere ARM" "aarch64-linux-gnu (Ampere)"  "$(status_of_target "Oracle Ampere ARM")" \
    "Windows 64-bit"    "x86_64-w64-mingw32"          "$(status_of_target "Windows 64-bit")" \
    3>&1 1>&2 2>&3
}

apply_selection() {
  local selected="$1"
  local count=0
  local item

  for target in "${ALL_RECIPE_TARGETS[@]}"; do
    SELECTED["$target"]="n"
  done

  while IFS= read -r item; do
    [[ -z "$item" ]] && continue
    is_known_recipe_target "$item" || continue
    SELECTED["$item"]="y"
    count=$((count + 1))
  done < <(printf '%s\n' "$selected" | grep -oE '"[^"]+"' | tr -d '"')

  [[ "$count" -ge 1 ]]
}

warn_on_cross_targets() {
  local native_target="$1"
  local has_non_native="no"

  for target in "${ALL_RECIPE_TARGETS[@]}"; do
    if [[ "${SELECTED[$target]:-n}" == "y" && "$target" != "$native_target" ]]; then
      has_non_native="yes"
      break
    fi
  done

  [[ "$has_non_native" == "no" ]] && return 0

  whiptail \
    --title "Cross-Build Warning" \
    --yesno "You selected one or more non-native targets.\n\nThese may require extra cross-build toolchains, headers, or support packages.\n\nExamples:\n- Windows 64-bit: MinGW-w64 / NSIS\n- ARM targets: cross GCC / binutils packages\n\nContinue and write recipe_book.conf?" \
    18 78
}

write_preview_file() {
  {
    echo "# recipe_book.conf - Generated by childe; a bake toolchain"
    echo "# Format: Arch_Target,y|n {build?}"
    echo

    for target in "${ALL_RECIPE_TARGETS[@]}"; do
      echo "${target},${SELECTED[$target]}"
    done
  } > "${RECIPE_BOOK}.tmp.preview"
}

main() {
  require_whiptail
  require_kitchen

  load_existing_selection

  local selected
  while true; do
    if ! selected="$(show_checklist)"; then
      echo "[INFO] Selection cancelled, NO changes were made."
      exit 1
    fi

    if apply_selection "$selected"; then
      break
    fi

    whiptail \
      --title "Selection Required" \
      --msgbox "At least one build target must be selected." \
      10 60
  done

  local native_target
  native_target="$(detect_default_friendly_target)"

  if ! warn_on_cross_targets "$native_target"; then
    echo "[INFO] Cancelled. No changes made."
    exit 1
  fi

  write_preview_file

  if ! whiptail \
    --title "Preview recipe_book.conf" \
    --textbox "${RECIPE_BOOK}.tmp.preview" 22 78; then
    rm -f "${RECIPE_BOOK}.tmp.preview"
    echo "[INFO] Cancelled. No changes made."
    exit 1
  fi

  if ! whiptail \
    --title "Write recipe_book.conf" \
    --yesno "Save this recipe_book.conf?" \
    10 60; then
    rm -f "${RECIPE_BOOK}.tmp.preview"
    echo "[INFO] Cancelled. No changes made."
    exit 1
  fi

  mv -f "${RECIPE_BOOK}.tmp.preview" "$RECIPE_BOOK"
  echo "[INFO] Wrote ${RECIPE_BOOK}"
}

main "$@"
