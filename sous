#!/usr/bin/env bash
set -Eeuo pipefail

RUN_DIR="$(pwd -P)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

BAKE_OPT_ROOT="/opt/bake"
OPT_BAKE_INFO="${BAKE_OPT_ROOT}/bake.info"
OPT_KITCHEN_LIB="${BAKE_OPT_ROOT}/kitchen.lib"

LOCAL_KITCHEN_LIB="${SCRIPT_DIR}/assets/kitchen.lib"
FIRST_RUN_APP="${SCRIPT_DIR}/first_run"
VERSION_FILE="${SCRIPT_DIR}/version.properties"

DO_UPDATE="no"
DO_REPAIR="no"
DO_UNINSTALL="no"
FORCE_ACTION="no"

green()  { echo -e "\033[1;32m$*\033[0m"; }
red()    { echo -e "\033[1;31m$*\033[0m"; }
yellow() { echo -e "\033[1;33m$*\033[0m"; }
blue()   { echo -e "\033[1;34m$*\033[0m"; }

log()  { green "[sous] $*"; }
warn() { yellow "[sous] $*"; }
err()  { red "[sous] $*" >&2; }
die()  { err "$*"; exit 1; }

usage() {
  cat <<'EOF'
Usage:
  ./sous [-up] [-r] [--uninstall] [-f] [-h]

Options:
  -up          Update Bake from GitHub and refresh /opt/bake/kitchen.lib
  -r           Repair bake toolset runtime under /opt/bake
  --uninstall  Remove /opt/bake and the local Bake repo
  -f           Force the selected action even if it appears unnecessary
  -h           Show help

Notes:
  -up refuses to update if local changes are present.
  -up -f discards local changes and force-syncs to origin/<current-branch>.

If run with no flags and whiptail is installed, Sous opens an interactive menu.
EOF
}

require_sudo() {
  sudo -v || die "sudo authentication failed"
}

has_whiptail() {
  command -v whiptail >/dev/null 2>&1
}

check_git_repo() {
  [[ -d "${SCRIPT_DIR}/.git" ]] || die "This does not look like a Bake git checkout: ${SCRIPT_DIR}"
}

read_kitchen_version_from_file() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  grep -E '^[[:space:]]*KITCHEN_LIB_VERSION[[:space:]]*=' "$file" \
    | head -n1 | cut -d= -f2- | tr -d '"' | tr -d "'" \
    | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

read_bake_version_from_file() {
  [[ -f "$VERSION_FILE" ]] || { echo "unknown"; return 0; }

  if grep -qE '^[[:space:]]*BAKE_VERSION[[:space:]]*=' "$VERSION_FILE"; then
    grep -E '^[[:space:]]*BAKE_VERSION[[:space:]]*=' "$VERSION_FILE" \
      | head -n1 | cut -d= -f2- | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
  else
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//' "$VERSION_FILE"
  fi
}

set_info_value() {
  local key="$1"
  local value="$2"

  require_sudo
  sudo mkdir -p "$BAKE_OPT_ROOT"
  sudo touch "$OPT_BAKE_INFO"

  if sudo grep -qE "^${key}=" "$OPT_BAKE_INFO"; then
    sudo sed -i "s|^${key}=.*|${key}=${value}|" "$OPT_BAKE_INFO"
  else
    echo "${key}=${value}" | sudo tee -a "$OPT_BAKE_INFO" >/dev/null
  fi
}

ensure_bake_info() {
  require_sudo
  sudo mkdir -p "$BAKE_OPT_ROOT"

  if [[ ! -f "$OPT_BAKE_INFO" ]]; then
    local kitchen_ver="unknown"
    local bake_ver="unknown"

    kitchen_ver="$(read_kitchen_version_from_file "$LOCAL_KITCHEN_LIB" || echo "unknown")"
    bake_ver="$(read_bake_version_from_file)"

    sudo tee "$OPT_BAKE_INFO" >/dev/null <<EOF
# Bake Toolset Information
BAKE_VERSION=${bake_ver}
KITCHEN_LIB_VERSION=${kitchen_ver}
SCRIPT_INSTALL=${SCRIPT_DIR}
FIRST_RUN=YES
EOF
    log "Created ${OPT_BAKE_INFO}"
  fi
}

refresh_kitchen_to_opt() {
  [[ -f "$LOCAL_KITCHEN_LIB" ]] || die "Missing local kitchen.lib: $LOCAL_KITCHEN_LIB"
  require_sudo
  sudo mkdir -p "$BAKE_OPT_ROOT"
  sudo cp -f "$LOCAL_KITCHEN_LIB" "$OPT_KITCHEN_LIB"
  sudo chmod 644 "$OPT_KITCHEN_LIB"
  log "Updated ${OPT_KITCHEN_LIB}"
}

delete_first_run_if_present() {
  if [[ -e "$FIRST_RUN_APP" ]]; then
    rm -f -- "$FIRST_RUN_APP"
    log "Removed first_run"
  fi
}

current_branch_name() {
  git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown"
}

local_head_commit() {
  git -C "$SCRIPT_DIR" rev-parse HEAD 2>/dev/null || echo ""
}

remote_tracking_ref() {
  local branch
  branch="$(current_branch_name)"
  [[ "$branch" == "unknown" || "$branch" == "HEAD" ]] && return 1
  echo "origin/${branch}"
}

remote_head_commit() {
  local tracking
  tracking="$(remote_tracking_ref)" || return 1
  git -C "$SCRIPT_DIR" rev-parse "$tracking" 2>/dev/null || return 1
}

git_tree_dirty() {
  [[ -n "$(git -C "$SCRIPT_DIR" status --porcelain)" ]]
}

show_dirty_tree() {
  warn "Local changes detected:"
  git -C "$SCRIPT_DIR" status --short
}

refuse_dirty_update_unless_forced() {
  if git_tree_dirty && [[ "$FORCE_ACTION" != "yes" ]]; then
    show_dirty_tree
    die "Update refused. Commit/stash changes first, or use: ./sous -up -f"
  fi
}

force_sync_to_remote() {
  local branch tracking

  branch="$(current_branch_name)"
  [[ "$branch" != "HEAD" && "$branch" != "unknown" ]] || die "Cannot force update from detached HEAD."

  tracking="origin/${branch}"

  git -C "$SCRIPT_DIR" rev-parse --verify "$tracking" >/dev/null 2>&1 \
    || die "Remote tracking branch not found: ${tracking}"

  warn "Force update will discard local changes and untracked files."
  git -C "$SCRIPT_DIR" reset --hard "$tracking"
  git -C "$SCRIPT_DIR" clean -fd
  log "Repository force-synced to ${tracking}"
}

print_status_header() {
  local bake_ver kitchen_ver branch local_head remote_head
  bake_ver="$(read_bake_version_from_file)"
  kitchen_ver="$(read_kitchen_version_from_file "$LOCAL_KITCHEN_LIB" || echo "unknown")"
  branch="$(current_branch_name)"
  local_head="$(local_head_commit)"
  remote_head="$(remote_head_commit || echo "unknown")"

  echo
  blue "##################################"
  blue "# Sous - Bake Toolset Maintainer #"
  blue "##################################"
  printf "%-18s %s\n" "Toolset path:" "$SCRIPT_DIR"
  printf "%-18s %s\n" "bake version:" "$bake_ver"
  printf "%-18s %s\n" "Kitchen lib:" "$kitchen_ver"
  printf "%-18s %s\n" "Git branch:" "$branch"
  printf "%-18s %s\n" "Local HEAD:" "${local_head:-unknown}"
  printf "%-18s %s\n" "Remote HEAD:" "${remote_head:-unknown}"
  echo
}

update_bake() {
  check_git_repo
  require_sudo

  log "Checking for bake updates..."
  git -C "$SCRIPT_DIR" fetch --all --tags

  local branch local_head remote_head
  branch="$(current_branch_name)"
  local_head="$(local_head_commit)"

  if [[ "$branch" == "HEAD" || "$branch" == "unknown" ]]; then
    warn "Detached HEAD or unknown branch detected."
    if [[ "$FORCE_ACTION" != "yes" ]]; then
      die "Use -up -f to force refresh, or checkout a branch first."
    fi
  fi

  remote_head="$(remote_head_commit || echo "")"

  if [[ "$FORCE_ACTION" == "yes" ]]; then
    log "Force update requested."
    force_sync_to_remote
  else
    refuse_dirty_update_unless_forced

    if [[ -n "$local_head" && -n "$remote_head" && "$local_head" == "$remote_head" ]]; then
      log "Bake is already current. No update required."
    else
      git -C "$SCRIPT_DIR" pull --rebase || die "git pull failed"
      log "Repository updated on branch: ${branch}"
    fi
  fi

  refresh_kitchen_to_opt
  ensure_bake_info

  local kitchen_ver bake_ver
  kitchen_ver="$(read_kitchen_version_from_file "$LOCAL_KITCHEN_LIB" || echo "unknown")"
  bake_ver="$(read_bake_version_from_file)"

  set_info_value KITCHEN_LIB_VERSION "$kitchen_ver"
  set_info_value BAKE_VERSION "$bake_ver"
  set_info_value SCRIPT_INSTALL "$SCRIPT_DIR"
  set_info_value LAST_APP "sous"
  set_info_value LAST_RUN "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  set_info_value LAST_ACTION "update"

  delete_first_run_if_present
  log "Update complete"
}

repair_bake() {
  log "Repairing Bake runtime..."
  require_sudo

  ensure_bake_info
  refresh_kitchen_to_opt

  local kitchen_ver bake_ver
  kitchen_ver="$(read_kitchen_version_from_file "$LOCAL_KITCHEN_LIB" || echo "unknown")"
  bake_ver="$(read_bake_version_from_file)"

  set_info_value KITCHEN_LIB_VERSION "$kitchen_ver"
  set_info_value BAKE_VERSION "$bake_ver"
  set_info_value SCRIPT_INSTALL "$SCRIPT_DIR"
  set_info_value LAST_APP "sous"
  set_info_value LAST_RUN "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  set_info_value LAST_ACTION "repair"

  delete_first_run_if_present
  log "Repair complete"
}

confirm_uninstall() {
  if has_whiptail; then
    whiptail \
      --title "Uninstall Bake" \
      --yesno "This will remove:\n\n${BAKE_OPT_ROOT}\n${SCRIPT_DIR}\n\nThis cannot be undone.\n\nContinue?" \
      16 72
  else
    read -r -p "Remove ${BAKE_OPT_ROOT} and ${SCRIPT_DIR}? This cannot be undone. [y/N] " ans
    [[ "${ans,,}" == "y" || "${ans,,}" == "yes" ]]
  fi
}

uninstall_bake() {
  confirm_uninstall || {
    log "Uninstall cancelled"
    exit 1
  }

  require_sudo

  log "Removing ${BAKE_OPT_ROOT} ..."
  sudo rm -rf -- "$BAKE_OPT_ROOT"

  log "Removing ${SCRIPT_DIR} ..."
  rm -rf -- "$SCRIPT_DIR"

  log "Uninstall complete"
}

menu_mode() {
  has_whiptail || die "No flags were provided and whiptail is not installed"

  print_status_header

  local choice
  choice="$(
    whiptail \
      --title "Sous - Bake Maintainer" \
      --menu "Choose an action" \
      18 76 8 \
      "1" "Update bake toolset from GitHub" \
      "2" "Force update bake toolset" \
      "3" "Repair bake runtime" \
      "4" "Uninstall" \
      "5" "Exit" \
      3>&1 1>&2 2>&3
  )" || exit 1

  case "$choice" in
    1) update_bake ;;
    2) FORCE_ACTION="yes"; update_bake ;;
    3) repair_bake ;;
    4) uninstall_bake ;;
    5) exit 0 ;;
    *) die "Unknown menu choice" ;;
  esac
}

parse_args() {
  if [[ $# -eq 0 ]]; then
    menu_mode
    exit 0
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -up) DO_UPDATE="yes" ;;
      -r) DO_REPAIR="yes" ;;
      --uninstall) DO_UNINSTALL="yes" ;;
      -f) FORCE_ACTION="yes" ;;
      -h|--help) usage; exit 0 ;;
      *) die "Unknown option: $1" ;;
    esac
    shift
  done

  local count=0
  [[ "$DO_UPDATE" == "yes" ]] && count=$((count + 1))
  [[ "$DO_REPAIR" == "yes" ]] && count=$((count + 1))
  [[ "$DO_UNINSTALL" == "yes" ]] && count=$((count + 1))

  [[ "$count" -eq 1 ]] || die "Choose exactly one action: -up, -r, or --uninstall"
}

main() {
  parse_args "$@"

  print_status_header

  if [[ "$DO_UPDATE" == "yes" ]]; then
    update_bake
  elif [[ "$DO_REPAIR" == "yes" ]]; then
    repair_bake
  elif [[ "$DO_UNINSTALL" == "yes" ]]; then
    uninstall_bake
  else
    die "No action selected"
  fi
}

main "$@"
