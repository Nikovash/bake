#!/usr/bin/env bash
set -euo pipefail

# --- sudo error ---#
if [[ "$EUID" -eq 0 ]]; then
  echo "[Garnish] Do not run this tool with sudo."
  exit 1
fi

# --- Paths --- #
RUN_DIR="$(pwd -P)"
FLAGS_FILE="${RUN_DIR}/build_flags.list"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ASSET_PULL="${SCRIPT_DIR}/assets/asset_pull.sh"
OPT_KITCHEN_LIB="/opt/bake/kitchen.lib"

die() {
  echo "[ERROR] $*" >&2
  exit 1
}

require_whiptail() {
  command -v whiptail >/dev/null 2>&1 || die "whiptail is not installed. Install it with: sudo apt-get install whiptail"
}

require_kitchen() {
  [[ -f "$ASSET_PULL" ]] || die "Missing ${ASSET_PULL}"

  # shellcheck disable=SC1090
  source "$ASSET_PULL"
  ensure_kitchen_lib

  [[ -f "$OPT_KITCHEN_LIB" ]] || die "Missing ${OPT_KITCHEN_LIB} after asset pull."

  # shellcheck disable=SC1090
  source "$OPT_KITCHEN_LIB"
}

has_flag() {
  local needle="$1"
  [[ -f "$FLAGS_FILE" ]] || return 1
  grep -Fxq -- "$needle" "$FLAGS_FILE"
}

status_of() {
  [[ "$1" == "yes" ]] && echo ON || echo OFF
}

load_existing_selection() {
  # sane defaults
  GUI="yes"
  MINER="yes"
  TESTS="no"
  BENCH="no"
  DEBUG="no"
  HARDENING="yes"
  REDUCE_EXPORTS="yes"
  ZMQ="yes"
  STACKTRACES="no"
  CRASH_HOOKS="no"

  [[ -f "$FLAGS_FILE" ]] || return 0

  # GUI is special:
  # if NO_QT=1 or --with-gui=no exists, GUI is off
  if has_flag "NO_QT=1" || has_flag "--with-gui=no"; then
    GUI="no"
  else
    GUI="yes"
  fi

  has_flag "--enable-miner"            && MINER="yes" || MINER="no"
  has_flag "--enable-tests"            && TESTS="yes" || TESTS="no"
  has_flag "--enable-bench"            && BENCH="yes" || BENCH="no"
  has_flag "--enable-debug"            && DEBUG="yes" || DEBUG="no"
  has_flag "--enable-hardening"        && HARDENING="yes" || HARDENING="no"
  has_flag "--enable-reduce-exports"   && REDUCE_EXPORTS="yes" || REDUCE_EXPORTS="no"
  has_flag "--enable-zmq"              && ZMQ="yes" || ZMQ="no"
  has_flag "--enable-stacktraces"      && STACKTRACES="yes" || STACKTRACES="no"
  has_flag "--enable-crash-hooks"      && CRASH_HOOKS="yes" || CRASH_HOOKS="no"
}

show_checklist() {
  whiptail \
    --title "Bake toolchain - Garnish" \
    --checklist "Select build options\n\nArrow keys = move\nSpace = toggle\nTab = buttons\nEnter = submit" \
    22 78 12 \
    "GUI"            "Build GUI wallet"          "$(status_of "$GUI")" \
    "MINER"          "Enable in-wallet miner"    "$(status_of "$MINER")" \
    "TESTS"          "Compile tests"             "$(status_of "$TESTS")" \
    "BENCH"          "Compile benchmarks"        "$(status_of "$BENCH")" \
    "DEBUG"          "Enable debug build"        "$(status_of "$DEBUG")" \
    "HARDENING"      "Enable hardening"          "$(status_of "$HARDENING")" \
    "REDUCE_EXPORTS" "Enable reduce-exports"     "$(status_of "$REDUCE_EXPORTS")" \
    "ZMQ"            "Enable ZMQ support"        "$(status_of "$ZMQ")" \
    "STACKTRACES"    "Enable stack traces"       "$(status_of "$STACKTRACES")" \
    "CRASH_HOOKS"    "Enable crash hooks"        "$(status_of "$CRASH_HOOKS")" \
    3>&1 1>&2 2>&3
}

apply_selection() {
  local selected="$1"
  local item

  GUI="no"
  MINER="no"
  TESTS="no"
  BENCH="no"
  DEBUG="no"
  HARDENING="no"
  REDUCE_EXPORTS="no"
  ZMQ="no"
  STACKTRACES="no"
  CRASH_HOOKS="no"

  while IFS= read -r item; do
    [[ -z "$item" ]] && continue

    case "$item" in
      GUI)            GUI="yes" ;;
      MINER)          MINER="yes" ;;
      TESTS)          TESTS="yes" ;;
      BENCH)          BENCH="yes" ;;
      DEBUG)          DEBUG="yes" ;;
      HARDENING)      HARDENING="yes" ;;
      REDUCE_EXPORTS) REDUCE_EXPORTS="yes" ;;
      ZMQ)            ZMQ="yes" ;;
      STACKTRACES)    STACKTRACES="yes" ;;
      CRASH_HOOKS)    CRASH_HOOKS="yes" ;;
    esac
  done < <(printf '%s\n' "$selected" | grep -oE '"[^"]+"' | tr -d '"')
}

write_preview_file() {
  {
    echo "# build_flags.list"
    echo "# Generated by garnish"
    echo "# NO_QT=1 must be first if present"
    echo "# All remaining lines are configure flags"
    echo

    if [[ "$GUI" == "no" ]]; then
      echo "NO_QT=1"
      echo "--with-gui=no"
    fi

    [[ "$MINER" == "yes" ]]          && echo "--enable-miner"          || echo "--disable-miner"
    [[ "$TESTS" == "yes" ]]          && echo "--enable-tests"          || echo "--disable-tests"
    [[ "$BENCH" == "yes" ]]          && echo "--enable-bench"          || echo "--disable-bench"
    [[ "$DEBUG" == "yes" ]]          && echo "--enable-debug"          || echo "--disable-debug"
    [[ "$HARDENING" == "yes" ]]      && echo "--enable-hardening"      || echo "--disable-hardening"
    [[ "$REDUCE_EXPORTS" == "yes" ]] && echo "--enable-reduce-exports" || echo "--disable-reduce-exports"
    [[ "$ZMQ" == "yes" ]]            && echo "--enable-zmq"            || echo "--disable-zmq"
    [[ "$STACKTRACES" == "yes" ]]    && echo "--enable-stacktraces"    || echo "--disable-stacktraces"
    [[ "$CRASH_HOOKS" == "yes" ]]    && echo "--enable-crash-hooks"    || echo "--disable-crash-hooks"
  } > "${FLAGS_FILE}.tmp.preview"
}

main() {
  require_whiptail
  require_kitchen

  load_existing_selection

  local selected
  if ! selected="$(show_checklist)"; then
    echo "[INFO] Cancelled. No changes made."
    exit 1
  fi

  apply_selection "$selected"
  write_preview_file

  if ! whiptail \
    --title "Preview build_flags.list" \
    --textbox "${FLAGS_FILE}.tmp.preview" 22 78; then
    rm -f "${FLAGS_FILE}.tmp.preview"
    echo "[INFO] Cancelled. No changes made."
    exit 1
  fi

  if ! whiptail \
    --title "Write build_flags.list" \
    --yesno "Save this build_flags.list?" 10 60; then
    rm -f "${FLAGS_FILE}.tmp.preview"
    echo "[INFO] Cancelled. No changes made."
    exit 1
  fi

  mv -f "${FLAGS_FILE}.tmp.preview" "$FLAGS_FILE"
  echo "[INFO] Wrote ${FLAGS_FILE}"
}

main "$@"
